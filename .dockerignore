# =============================================================================
# Root context fallback. Prefer: docker build -f backend/Dockerfile backend
# If someone builds with context `.`, keep secrets and frontend out.
# =============================================================================

# Dependencies & build output
node_modules/
dist/
dist-ssr/
build/
coverage/
.turbo/
.vite/
*.tsbuildinfo

# Secrets — never send real env files
.env
.env.*
*.env
.envrc
.direnv/
*.pem
*.p12
*.pfx
**/credentials.json
**/service-account*.json
.secrets/
secrets/

# Backend local noise
backend/.venv/
backend/venv/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.env
backend/.env.*
backend/data/
backend/tests/
backend/**/__pycache__/
.uv/

# Local data
data/manual-collection/candidates.jsonl
*.sqlite
*.sqlite3
*.dump
*.sql.gz
dump.rdb

# Tooling / VCS / editors
.git/
.github/
.grok/
.claude/
.cursor/
.agent/
.agents/
.vscode/
.idea/
.ruff_cache/
.pytest_cache/
.mypy_cache/
docs/
**/*.md
.DS_Store
Thumbs.db
*~
*.bak
*.orig

# Frontend is not part of the backend image
src/
public/
index.html
package.json
package-lock.json
vite.config.ts
tsconfig*.json
.oxlintrc.json
.nvmrc
.coderabbit.yaml
.gitleaks.toml
Makefile
scripts/
infra/
