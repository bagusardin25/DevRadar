# Frontend (Vite) — optional. Copy to repo-root .env if you need overrides.
# Backend settings live in backend/.env.example → backend/.env (see README).
#
# Leave VITE_API_BASE_URL empty to use same-origin + the Vite proxy in development
# (vite.config.ts proxies /api and /health → VITE_PROXY_TARGET).
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Proxy target when using relative API paths (default matches local API)
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# Repository the "Report issue" button files against. Point this at your fork
# when self-hosting; set it to an empty value to hide the button entirely.
# VITE_REPO_URL=https://github.com/bagusardin25/DevRadar
