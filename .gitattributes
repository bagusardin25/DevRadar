# Normalize text files; let Git pick the working-tree EOL for the platform.
* text=auto

# Source and config — LF in the repo for cross-platform consistency.
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.sql text eol=lf
*.sh text eol=lf
Makefile text eol=lf
.env.example text eol=lf

# Windows scripts keep CRLF so they open cleanly in PowerShell/Notepad.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never treat as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.zip binary
*.node binary
