# --- Dependencies & build ---
node_modules/
dist/
dist-ssr/
build/
*.local

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment & secrets (never commit real env files) ---
.env
.env.*
!.env.example
!**/.env.example
*.env
!*.env.example
.envrc
.direnv/

# Private keys, certs, cloud credentials
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_dsa
id_dsa.*
*.ppk
.aws/credentials
.aws/config
.netrc
**/credentials.json
**/service-account*.json
**/*-service-account*.json
**/secrets.yaml
**/secrets.yml
**/secrets.json
.secrets/
secrets/

# --- Manual X/MCP collection (may include draft leads) ---
data/manual-collection/candidates.jsonl
backend/data/

# Local DBs / dumps that may hold PII
*.sqlite
*.sqlite3
*.db
!backend/tests/**/*.db
*.dump
*.sql.gz


# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Local AI / agent tooling ---
.claude/
.grok/
.cursor/
.agent/
.agents/

# --- Local / internal documentation (not published with the open-source tree) ---
docs/

# Markdown: allow a few root docs and GitHub meta only; ignore other local notes
*.md
!**/README.md
!CONTRIBUTING.md
!SECURITY.md
!CODE_OF_CONDUCT.md
!CHANGELOG.md
!LICENSE
!.github/**/*.md
