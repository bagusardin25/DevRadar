# =============================================================================
# DevRadar .gitignore
# Generated caches, build output, logs, local DBs, and runtime data must stay
# out of git. Secrets are covered in a dedicated section below.
# =============================================================================

# --- Dependencies ---
node_modules/
jspm_packages/
bower_components/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build output (frontend + extension) ---
dist/
dist-ssr/
dist-firefox/
build/
out/
.turbo/
.vite/
.parcel-cache/
.vercel/
.netlify/
*.tsbuildinfo
*.local
.eslintcache
.stylelintcache
.nyc_output/
storybook-static/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# --- Coverage reports ---
coverage/
*.lcov
.nyc_output/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- Environment & secrets (never commit real env files) ---
.env
.env.*
!.env.example
!**/.env.example
!.env.production.example
!**/.env.production.example
*.env
!*.env.example
!.env.production.example
.envrc
.direnv/

# Private keys, certs, cloud credentials
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_dsa
id_dsa.*
*.ppk
.aws/credentials
.aws/config
.netrc
**/credentials.json
**/service-account*.json
**/*-service-account*.json
**/secrets.yaml
**/secrets.yml
**/secrets.json
.secrets/
secrets/

# --- Manual X/MCP collection (may include draft leads) ---
data/manual-collection/candidates.jsonl

# --- Runtime data / object storage / local DBs ---
# backend/data covers OBJECT_STORAGE_LOCAL_PATH=./data/raw and operator dumps
backend/data/
*.sqlite
*.sqlite3
*.db
!backend/tests/**/*.db
*.dump
*.sql.gz
dump.rdb
appendonly.aof
*.pid
celerybeat-schedule
celerybeat-schedule.*

# --- Python: bytecode, envs, caches, tooling ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
wheels/
pip-wheel-metadata/
share/python-wheels/
.venv/
venv/
env/
.uv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/

# --- Editor / OS / backups ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.bak
*.orig
*.tmp
*.temp

# --- Local AI / agent tooling ---
.claude/
.grok/
.cursor/
.agent/
.agents/

# --- Local / internal documentation (not published with the open-source tree) ---
docs/

# Markdown: allow a few root docs and GitHub meta only; ignore other local notes
*.md
!**/README.md
!CONTRIBUTING.md
!SECURITY.md
!CODE_OF_CONDUCT.md
!CHANGELOG.md
!LICENSE
!.github/**/*.md
