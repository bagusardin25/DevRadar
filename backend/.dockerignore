# =============================================================================
# Docker build context for: docker build -f backend/Dockerfile backend
# Only pyproject.toml, uv.lock, app/, alembic/, alembic.ini, scripts/ are needed.
# Never send secrets, tests, caches, or local data into the daemon.
# =============================================================================

# --- Secrets & env (no .env of any kind enters the context) ---
.env
.env.*
*.env
.envrc
.direnv/
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
id_dsa*
*.ppk
**/credentials.json
**/service-account*.json
**/*-service-account*.json
**/secrets.yaml
**/secrets.yml
**/secrets.json
.secrets/
secrets/

# --- Virtualenvs & package caches ---
.venv/
venv/
env/
.uv/
**/.python-version
wheels/
pip-wheel-metadata/

# --- Python caches & tooling ---
**/__pycache__/
**/*.py[cod]
**/*$py.class
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
.dmypy.json
dmypy.json

# --- Runtime data / logs / dumps ---
data/
logs/
*.log
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
dump.rdb
appendonly.aof
celerybeat-schedule
celerybeat-schedule.*
*.pid

# --- Tests (never bake into the runtime image) ---
tests/
**/conftest.py
**/test_*.py
**/*_test.py

# --- VCS / editor / OS / agent tooling ---
.git/
.gitignore
.gitattributes
.editorconfig
.vscode/
.idea/
.claude/
.grok/
.cursor/
.agent/
.agents/
.DS_Store
Thumbs.db
Desktop.ini
*~
*.bak
*.orig
*.swp
*.swo
*.tmp

# --- Docs & files not required at runtime ---
**/*.md
Dockerfile*
.dockerignore
.gitleaks.toml
*.example
