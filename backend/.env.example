# DevRadar Backend Environment Configuration
# Copy to .env and update values for your environment

APP_ENV=development
API_BASE_PATH=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# Database
DATABASE_URL=postgresql+asyncpg://devradar:devradar@127.0.0.1:5434/devradar

# Redis
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3-compatible / MinIO)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=devradar-raw
OBJECT_STORAGE_ACCESS_KEY=local-development-only
OBJECT_STORAGE_SECRET_KEY=local-development-only
OBJECT_STORAGE_REGION=us-east-1

# Security
SESSION_SECRET=replace-with-at-least-32-random-bytes
EMAIL_ENCRYPTION_KEY=replace-with-a-valid-key
EMAIL_HMAC_KEY=replace-with-at-least-32-random-bytes

# GitHub OAuth (Admin Authentication)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_IDS=[]

# Email
EMAIL_PROVIDER=console
EMAIL_FROM=alerts@example.test

# LLM Provider
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=

# X/Twitter API
X_BEARER_TOKEN=
