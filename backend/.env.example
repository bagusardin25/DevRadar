# =============================================================================
# DevRadar Backend — DEVELOPMENT / seed-demo template
# Copy to backend/.env (never commit .env). See README.md + SECURITY.md.
# Values match local Docker Compose (infra/compose.yaml).
#
# For production hosts use backend/.env.production.example as a checklist
# (APP_ENV=production enables stricter validation + Secure cookies).
# =============================================================================

# --- App (required) ---
# development = local defaults OK | test = CI/pytest | production = hardened
APP_ENV=development
API_BASE_PATH=/api/v1
FRONTEND_URL=http://localhost:5173
# Comma-separated or JSON array
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (required) — Compose maps host 5434 -> container 5432 ---
DATABASE_URL=postgresql+asyncpg://devradar:devradar@127.0.0.1:5434/devradar

# --- Redis (required) — sessions, rate limits, Celery ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Proxy trust — how many proxies sit in front of the app ---
# 0 = directly exposed, X-Forwarded-For ignored. Set to 1 behind a single load
# balancer (Railway, Fly, nginx). Leaving this at 0 when a proxy IS in front
# buckets every visitor under the proxy IP; raising it above the real hop count
# lets callers forge the header and slip past the anonymous rate limits.
TRUSTED_PROXY_HOPS=0

# --- Secrets (required) — generate unique values; never commit .env ---
SESSION_SECRET=replace-with-at-least-32-random-bytes
EMAIL_ENCRYPTION_KEY=replace-with-a-valid-key
EMAIL_HMAC_KEY=replace-with-at-least-32-random-bytes

# --- Object storage ---
# local = filesystem under OBJECT_STORAGE_LOCAL_PATH (default for OSS seed demo)
# s3    = MinIO (compose service on :9000) or AWS — set endpoint/keys below
# memory = tests / CI only
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_PATH=./data/raw
# Used when OBJECT_STORAGE_BACKEND=s3 (Compose MinIO defaults):
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=devradar-raw
OBJECT_STORAGE_ACCESS_KEY=devradar
OBJECT_STORAGE_SECRET_KEY=devradar123
OBJECT_STORAGE_REGION=us-east-1

# --- Fetch policy (optional) ---
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_BYTES=5242880
FETCH_MAX_REDIRECTS=5
# Caps JSON/form bodies even when the API is run without a reverse proxy.
MAX_REQUEST_BODY_BYTES=1048576
# Stops slow/stalled upload bodies from occupying a worker indefinitely.
REQUEST_BODY_READ_TIMEOUT_SECONDS=15

# --- Admin Google OAuth — fill when you need admin login ---
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Allowlisted admin emails, comma-separated (e.g. you@example.com,other@team.com).
# Only these verified Google accounts may sign in.
ADMIN_GOOGLE_EMAILS=
# Public origin of THIS API (scheme + host [+ port]) used to build the OAuth
# callback. Leave empty for local dev -> http://localhost:8000. REQUIRED when
# APP_ENV=production. Must match an Authorized redirect URI on the Google OAuth
# client, i.e. <base>/api/v1/admin/auth/google/callback — and share the
# frontend's host so the session cookie is returned (localhost != 127.0.0.1).
OAUTH_REDIRECT_BASE_URL=

# --- Email alerts (Wave E) ---
# console = log only (dev) | resend = Resend HTTP API | smtp = SMTP relay
EMAIL_PROVIDER=console
EMAIL_FROM=alerts@example.test
# Resend: https://resend.com → API Keys
RESEND_API_KEY=
# SMTP (e.g. Mailpit, Postmark SMTP, Gmail app password — prefer dedicated relay)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# --- Operator webhook (Wave E) — optional Discord/n8n/etc. ---
# POST JSON when alerts.scan_matches finds newly published listings
WEBHOOK_URL=
# Optional HMAC-SHA256 secret → header X-DevRadar-Signature: sha256=<hex>
WEBHOOK_SECRET=
# Optional filter JSON, e.g. {"kind":"hackathon","onlyClosingSoon":true}
WEBHOOK_FILTER_JSON=

# --- LLM extraction (structured fields from fetched page text; NOT web_search) ---
# disabled | openai
# Use "disabled" for seed-only / demo self-host (no OpenAI key required).
LLM_PROVIDER=disabled
LLM_MODEL=gpt-4o-mini
# Prefer LLM_API_KEY; OPENAI_API_KEY is also accepted as alias
LLM_API_KEY=

# --- AI initial review (CodeRabbit-style pre-review for the admin queue) ---
# When true, each community submission gets an automated "AI Initial Review"
# (recommendation + concerns + suggested fields) attached to its admin review
# item. It runs on the deterministic verifier by default (no key needed); when
# LLM_PROVIDER=openai + LLM_API_KEY are set it is enriched with an LLM-written
# assessment. The admin always makes the final approve/reject decision.
AI_REVIEW_ENABLED=true

# --- X / Twitter discovery (optional) ---
X_BEARER_TOKEN=
