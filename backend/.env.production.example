# =============================================================================
# DevRadar Backend — PRODUCTION template (checklist)
# Copy to a secret store or host env (never commit real values).
# Local seed-demo uses backend/.env.example → backend/.env instead.
# =============================================================================

# --- App (required) ---
APP_ENV=production
API_BASE_PATH=/api/v1
# Public browser origin of the SPA (https required when APP_ENV=production)
FRONTEND_URL=https://app.example.com
# Exact allowed origins (no wildcard). Comma-separated or JSON array.
CORS_ORIGINS=https://app.example.com

# --- PostgreSQL (required) — use a strong unique password, not Compose defaults ---
DATABASE_URL=postgresql+asyncpg://devradar:CHANGE_ME_STRONG_PASSWORD@db.internal:5432/devradar

# --- Redis (required) ---
REDIS_URL=redis://redis.internal:6379/0

# --- Proxy trust — almost always 1 behind Railway/Fly/nginx/Caddy ---
TRUSTED_PROXY_HOPS=1

# --- Secrets (required) — generate unique values; never reuse .env.example placeholders ---
# e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
EMAIL_ENCRYPTION_KEY=
EMAIL_HMAC_KEY=

# --- Object storage ---
# Prefer s3 (MinIO/AWS) in multi-instance deploys; local is single-node only.
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_LOCAL_PATH=./data/raw
OBJECT_STORAGE_ENDPOINT=https://s3.example.com
OBJECT_STORAGE_BUCKET=devradar-raw
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=us-east-1

# --- Fetch policy (optional) ---
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_BYTES=5242880
FETCH_MAX_REDIRECTS=5
# Keep aligned with (or below) the reverse-proxy request-body limit.
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_BODY_READ_TIMEOUT_SECONDS=15

# --- Admin Google OAuth (required for operator login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_GOOGLE_EMAILS=ops@example.com
# Public https origin of THIS API (must match Google Authorized redirect URI)
# Callback path: {OAUTH_REDIRECT_BASE_URL}{API_BASE_PATH}/admin/auth/google/callback
OAUTH_REDIRECT_BASE_URL=https://api.example.com

# --- Email alerts ---
# Prefer resend or smtp in production; console only logs (no delivery).
EMAIL_PROVIDER=resend
EMAIL_FROM=alerts@example.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# --- Operator webhook (optional) ---
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_FILTER_JSON=

# --- LLM (optional) ---
LLM_PROVIDER=disabled
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# --- AI initial review ---
AI_REVIEW_ENABLED=true

# --- X / Twitter discovery (optional) ---
X_BEARER_TOKEN=
