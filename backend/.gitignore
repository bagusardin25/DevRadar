# =============================================================================
# Backend-local ignores (also covered by the monorepo root .gitignore).
# =============================================================================

# Environment and secrets
.env
.env.*
!.env.example
!.env.production.example
*.env
!*.env.example
!.env.production.example
.envrc
.direnv/

# Private keys & cloud credentials
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
id_dsa*
*.ppk
**/credentials.json
**/service-account*.json
**/*-service-account*.json
**/secrets.yaml
**/secrets.yml
**/secrets.json
.secrets/
secrets/

# Python bytecode / packages
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
wheels/
pip-wheel-metadata/

# Virtual environments & package caches
.venv/
venv/
env/
.uv/

# Test / type / lint / coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
.dmypy.json
dmypy.json

# Worker / process state
celerybeat-schedule
celerybeat-schedule.*
*.pid
dump.rdb
appendonly.aof

# Local tooling
.python-version

# Runtime data: OBJECT_STORAGE_LOCAL_PATH (default ./data/raw) and operator dumps
data/

# Local DB dumps
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# Logs
logs/
*.log

# Editor / OS / backups
.vscode/
.idea/
.DS_Store
Thumbs.db
*~
*.bak
*.orig
*.swp
*.tmp
