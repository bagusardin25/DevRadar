{
  "name": "devradar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:stress": "node tools/frontend-stress.mjs",
    "check": "npm run test:stress && npm run build && npm run lint",
    "preview": "vite preview",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean.ps1",
    "check:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/check.ps1",
    "bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev.ps1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.86.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.1"
  }
}
